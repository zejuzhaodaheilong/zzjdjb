#include <stdio.h>

#define MAX 100
#define INF 999999

int Prim(int graph[MAX][MAX], int n)
{
    int lowcost[MAX];
    int visited[MAX] = {0};

    int i, j;
    int min, k;
    int sum = 0;

    visited[0] = 1;

    for(i = 0; i < n; i++)
    {
        lowcost[i] = graph[0][i];
    }

    for(i = 1; i < n; i++)
    {
        min = INF;

        for(j = 0; j < n; j++)
        {
            if(!visited[j] && lowcost[j] < min)
            {
                min = lowcost[j];
                k = j;
            }
        }

        visited[k] = 1;
        sum += min;

        for(j = 0; j < n; j++)
        {
            if(!visited[j] &&
               graph[k][j] < lowcost[j])
            {
                lowcost[j] = graph[k][j];
            }
        }
    }

    return sum;
}
